# Copy to .env.local (local) or set on Hostinger. Never commit real values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
SESSION_SECRET=
CRON_SECRET=
# Email (optional until you switch it on in Admin → Settings)
RESEND_API_KEY=
SITE_URL=
EMAIL_FROM=
# Member login (Auth0). APP_BASE_URL = this site's URL, e.g. https://wideopen.world
APP_BASE_URL=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 64-char random string: openssl rand -hex 32
AUTH0_SECRET=
